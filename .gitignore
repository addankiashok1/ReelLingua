# ─────────────────────────────────────────────────────────────
#  ReelSync AI — .gitignore
#  Single file covering: Python backend + Next.js frontend
# ─────────────────────────────────────────────────────────────

# ── Environment variables (never commit secrets) ──────────────
.env
.env.local
.env.*.local

# ── Python: virtual environments ──────────────────────────────
venv/
.venv/
env/
ENV/

# ── Python: bytecode & import cache ───────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Python: packaging & distribution ──────────────────────────
*.egg-info/
*.egg
dist/
build/
wheels/
.eggs/
MANIFEST

# ── Python: test & static-analysis artefacts ──────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/

# ── Backend: generated video storage (large binary files) ─────
reelsync-backend/local_storage/
reelsync-backend/temp_outputs/

# ── Next.js frontend build artefacts ──────────────────────────
reelsync-frontend/node_modules/
reelsync-frontend/.next/
reelsync-frontend/out/
reelsync-frontend/.npm/
reelsync-frontend/.eslintcache
reelsync-frontend/next-env.d.ts

# ── Claude Code session files ─────────────────────────────────
.claude/

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
ehthumbs.db

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
